{
  "name": "dsh-skill-grill-with-docs",
  "version": "0.1.1",
  "description": "DeepSeek Harness skill provider packaging Matt Pocock's grill-with-docs, grilling and domain-modeling skills.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "grill-with-docs",
    "grilling",
    "domain-modeling",
    "adr",
    "glossary"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "PROVENANCE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2"
  },
  "license": "MIT",
  "author": "lvjiai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvjiai/dsh-skill-grill-with-docs.git"
  },
  "homepage": "https://github.com/lvjiai/dsh-skill-grill-with-docs#readme",
  "bugs": {
    "url": "https://github.com/lvjiai/dsh-skill-grill-with-docs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  }
}
